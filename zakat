        /* ===================================================
           3. UI CONTROLLER & RENDERING
           =================================================== */
        
        function updateHeader() {
            document.getElementById('scoreText').innerText = gameState.score;
            const levelBadge = document.getElementById('levelBadge');
            const progressBar = document.getElementById('progressBar');

            if (gameState.currentRound === 0) {
                levelBadge.innerText = "Info";
                progressBar.style.width = "5%";
            } else if (gameState.currentRound === 1) {
                levelBadge.innerText = "1/3";
                const p = 10 + (gameState.quizIndex / quizData.length) * 25;
                progressBar.style.width = `${p}%`;
            } else if (gameState.currentRound === 2) {
                levelBadge.innerText = "2/3";
                const p = 35 + (gameState.riceSimulatedCount / 3) * 30;
                progressBar.style.width = `${p}%`;
            } else if (gameState.currentRound === 3) {
                levelBadge.innerText = "3/3";
                const p = 65 + (gameState.sortedAsnafCount / gameState.targetAsnafCount) * 30;
                progressBar.style.width = `${p}%`;
            } else {
                levelBadge.innerText = "Selesai";
                progressBar.style.width = "100%";
            }
        }

