        function handleQuizAnswer(selectedIdx) {
            const currentQ = quizData[gameState.quizIndex];
            const buttons = document.querySelectorAll('.quiz-btn');
            const feedbackEl = document.getElementById('quizFeedback');
            const nextBtn = document.getElementById('nextQuizBtn');

            // Disable further clicks
            buttons.forEach(btn => btn.disabled = true);

            if (selectedIdx === currentQ.correct) {
                sfx.playCorrect();
                gameState.score += 25;
                updateHeader();

                buttons[selectedIdx].classList.remove('border-slate-200', 'hover:border-emerald-500');
                buttons[selectedIdx].classList.add('border-emerald-500', 'bg-emerald-100/80', 'text-emerald-900');
                
                feedbackEl.className = "p-4 rounded-xl text-sm font-medium leading-relaxed bg-emerald-50 border border-emerald-200 text-emerald-900 flex items-start gap-3";
                feedbackEl.innerHTML = `
                    <i class="fas fa-check-circle text-emerald-600 text-lg mt-0.5"></i>
                    <div>
                        <p class="font-bold mb-1 text-emerald-800">Jawaban Tepat! (+25 Skor)</p>
                        <p class="text-xs sm:text-sm text-emerald-700">${currentQ.explanation}</p>
                    </div>
                `;
            } else {
                sfx.playWrong();

                buttons[selectedIdx].classList.remove('border-slate-200');
                buttons[selectedIdx].classList.add('border-rose-400', 'bg-rose-50', 'text-rose-900');

                // Highlight correct one
                buttons[currentQ.correct].classList.remove('border-slate-200');
                buttons[currentQ.correct].classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900');

                feedbackEl.className = "p-4 rounded-xl text-sm font-medium leading-relaxed bg-rose-50 border border-rose-200 text-rose-900 flex items-start gap-3";
                feedbackEl.innerHTML = `
                    <i class="fas fa-times-circle text-rose-600 text-lg mt-0.5"></i>
                    <div>
                        <p class="font-bold mb-1 text-rose-800">Jawaban Kurang Tepat</p>
                        <p class="text-xs sm:text-sm text-rose-700">${currentQ.explanation}</p>
                    </div>
                `;
            }

            feedbackEl.classList.remove('hidden');
            nextBtn.classList.remove('hidden');
        }

        function nextQuizQuestion() {
            sfx.playClick();
            gameState.quizIndex++;
            if (gameState.quizIndex < quizData.length) {
                renderBabak1();
            } else {
                // Move to Babak 2
                gameState.riceSimulatedCount = 0;
                renderBabak2Intro();
            }
        }

        /* ===================================================
           5. BABAK 2: KALKULATOR SIMULASI BERAS PANITIA ZAKAT
           =================================================== */
        function renderBabak2Intro() {
            gameState.currentRound = 2;
            updateHeader();

            const card = document.getElementById('gameCard');
            card.innerHTML = `
                <div class="flex flex-col items-center text-center space-y-6 my-auto py-4">
                    <div class="w-20 h-20 rounded-2xl bg-amber-500 text-white flex items-center justify-center text-4xl shadow-lg shadow-amber-500/30">
                        <i class="fas fa-scale-balanced"></i>
                    </div>

                    <div class="max-w-md">
                        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800 mb-2">Babak 2</span>
                        <h3 class="text-2xl font-bold text-slate-800 mb-2">Kalkulator Amil Zakat</h3>
                        <p class="text-slate-600 text-sm leading-relaxed">
                            Kamu sekarang bertugas sebagai **Amil Zakat** di meja penerimaan masjid! Keluarga muzakki akan datang untuk membayar zakat fitrah. Hitung dan timbang beras mereka dengan tepat.
                        </p>
                    </div>

                    <div class="bg-amber-50 border border-amber-200 p-4 rounded-2xl text-left text-xs sm:text-sm text-amber-900 max-w-md space-y-1">
                        <p class="font-bold flex items-center gap-2">
                            <i class="fas fa-info-circle text-amber-600"></i> Rumus Zakat Fitrah:
                        </p>
                        <p>• Satuan Kilogram (Kg): <b>2,5 kg</b> per orang</p>
                        <p>• Satuan Liter: <b>3,5 liter</b> per orang</p>
                    </div>

                    <button onclick="startBabak2Simulation()" class="px-8 py-3.5 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-xl shadow-md transition transform active:scale-95 flex items-center gap-2">
                        <span>Mulai Menimbang</span>
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            `;
        }

        function generateRandomFamily() {
            const familyNames = ['Keluarga Pak Ahmad', 'Keluarga Bu Fatimah', 'Keluarga Pak Budi', 'Keluarga Pak Hasan'];
            const randomName = familyNames[Math.floor(Math.random() * familyNames.length)];
            
            const adults = Math.floor(Math.random() * 2) + 1; // 1-2
            const children = Math.floor(Math.random() * 3); // 0-2
            const totalMembers = adults + children;

            return {
                name: randomName,
                adults: adults,
                children: children,
                totalMembers: totalMembers
            };
        }

        function startBabak2Simulation() {
            sfx.playClick();
            gameState.currentFamily = generateRandomFamily();
            gameState.unitType = Math.random() > 0.5 ? 'kg' : 'liter';
            renderBabak2Calculator();
        }

        function renderBabak2Calculator() {
            const family = gameState.currentFamily;
            const unit = gameState.unitType;
            const card = document.getElementById('gameCard');

            const ratePerPerson = unit === 'kg' ? 2.5 : 3.5;
            const correctTotal = family.totalMembers * ratePerPerson;

            card.innerHTML = `
                <div class="flex flex-col justify-between h-full space-y-4">
                    <!-- Header simulation -->
                    <div class="flex justify-between items-center border-b border-slate-100 pb-3">
                        <div>
                            <span class="text-xs font-bold text-amber-600 uppercase tracking-wider">Simulasi Amil Zakat (${gameState.riceSimulatedCount + 1}/3)</span>
                            <h3 class="text-lg font-bold text-slate-800">${family.name}</h3>
                        </div>
                        <span class="bg-amber-100 text-amber-800 font-extrabold text-xs px-3 py-1.5 rounded-xl border border-amber-200">
                            Satuan: ${unit.toUpperCase()}
                        </span>
                    </div>

                    <!-- Family Details & Illustration -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-center my-auto">
                        <!-- Visitor Info Box -->
                        <div class="bg-slate-50 border border-slate-200 p-4 rounded-2xl flex flex-col items-center text-center space-y-3">
                            <div class="flex -space-x-2 overflow-hidden py-1">
                                ${Array(family.adults).fill(0).map(() => `
                                    <div class="inline-block h-10 w-10 rounded-full ring-2 ring-white bg-emerald-500 text-white flex items-center justify-center font-bold text-xs">
                                        <i class="fas fa-user"></i>
                                    </div>
                                `).join('')}
                                ${Array(family.children).fill(0).map(() => `
                                    <div class="inline-block h-8 w-8 rounded-full ring-2 ring-white bg-teal-400 text-white flex items-center justify-center font-bold text-xs my-auto">
                                        <i class="fas fa-child"></i>
                                    </div>
                                `).join('')}
                            </div>
                            <div>
                                <p class="text-xs text-slate-500 font-medium">Jumlah Anggota Keluarga:</p>
                                <p class="text-base font-extrabold text-slate-800">
                                    ${family.adults} Dewasa ${family.children > 0 ? '+ ' + family.children + ' Anak' : ''} 
                                    = <span class="text-emerald-600">${family.totalMembers} Orang</span>
                                </p>
                            </div>
                            <div class="text-xs text-amber-800 bg-amber-50 p-2 rounded-xl border border-amber-200/60 w-full">
                                Ketentuan: <b>${ratePerPerson} ${unit}</b> per orang
                            </div>
                        </div>

                        <!-- Scale Interactive Weighing Tool -->
                        <div class="bg-gradient-to-b from-amber-500/10 to-emerald-500/10 border border-emerald-200/80 p-5 rounded-2xl flex flex-col items-center text-center space-y-3">
                            <div class="text-4xl text-amber-600 animate-float">
                                <i class="fas fa-box-tissue"></i>
                            </div>
                            <label for="riceInput" class="text-xs font-bold text-slate-700">
                                Masukkan Total Beras yang Diterima (${unit}):
                            </label>
                            
                            <div class="flex items-center gap-2">
                                <input type="number" id="riceInput" step="0.1" min="0" placeholder="0.0" 
                                    class="w-32 text-center text-xl font-extrabold p-2.5 rounded-xl border-2 border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-white">
                                <span class="font-bold text-slate-600">${unit}</span>
                            </div>
                        </div>
                    </div>

                    <!-- Interactive Feedback Message -->
                    <div id="simFeedback" class="hidden p-3 rounded-xl text-xs sm:text-sm font-medium"></div>

                    <!-- Action Button -->
                    <div class="flex justify-end pt-2">
                        <button id="verifyRiceBtn" onclick="verifyRiceSimulation(${correctTotal})" class="px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl shadow-md transition flex items-center gap-2">
                            <i class="fas fa-check"></i>
                            <span>Timbang & Verifikasi</span>
                        </button>
                        <button id="nextSimBtn" onclick="nextRiceSimulation()" class="hidden px-6 py-3 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-xl shadow-md transition flex items-center gap-2">
                            <span>Lanjut Muzakki Berikutnya</span>
                            <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>
                </div>
            `;
        }

        function verifyRiceSimulation(correctTotal) {
            const inputEl = document.getElementById('riceInput');
            const userVal = parseFloat(inputEl.value);
            const feedbackEl = document.getElementById('simFeedback');
            const verifyBtn = document.getElementById('verifyRiceBtn');
            const nextBtn = document.getElementById('nextSimBtn');

            if (isNaN(userVal) || userVal <= 0) {
                alert("Masukkan angka jumlah beras terlebih dahulu!");
                return;
            }

            // Margin of error allowance for decimals
            if (Math.abs(userVal - correctTotal) < 0.05) {
                sfx.playCorrect();
                gameState.score += 30;
                updateHeader();

                feedbackEl.className = "p-3 rounded-xl text-xs sm:text-sm font-semibold bg-emerald-100 border border-emerald-300 text-emerald-900 flex items-center gap-2";
                feedbackEl.innerHTML = `<i class="fas fa-check-circle text-emerald-600 text-lg"></i> Tepat Sekali! Total beras untuk ${gameState.currentFamily.totalMembers} orang adalah ${correctTotal} ${gameState.unitType}. (+30 Skor)`;
                
                verifyBtn.classList.add('hidden');
                nextBtn.classList.remove('hidden');
            } else {
                sfx.playWrong();
                feedbackEl.className = "p-3 rounded-xl text-xs sm:text-sm font-semibold bg-rose-100 border border-rose-300 text-rose-900 flex items-center gap-2";
                feedbackEl.innerHTML = `<i class="fas fa-times-circle text-rose-600 text-lg"></i> Kurang tepat! Coba kalikan ${gameState.currentFamily.totalMembers} orang × ${gameState.unitType === 'kg' ? '2,5 kg' : '3,5 liter'}.`;
            }

            feedbackEl.classList.remove('hidden');
        }

        function nextRiceSimulation() {
            sfx.playClick();
            gameState.riceSimulatedCount++;

            if (gameState.riceSimulatedCount < 3) {
                gameState.currentFamily = generateRandomFamily();
                gameState.unitType = Math.random() > 0.5 ? 'kg' : 'liter';
                renderBabak2Calculator();
            } else {
                // Move to Babak 3 Intro
                renderBabak3Intro();
            }
        }

        /* ===================================================
           6. BABAK 3: SORTIR 8 ASNAF (DRAG & DROP / CLICK)
           =================================================== */
        function renderBabak3Intro() {
            gameState.currentRound = 3;
            updateHeader();

            const card = document.getElementById('gameCard');
            card.innerHTML = `
                <div class="flex flex-col items-center text-center space-y-6 my-auto py-4">
                    <div class="w-20 h-20 rounded-2xl bg-teal-500 text-white flex items-center justify-center text-4xl shadow-lg shadow-teal-500/30">
                        <i class="fas fa-users-viewfinder"></i>
                    </div>

                    <div class="max-w-md">
                        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-teal-100 text-teal-800 mb-2">Babak 3</span>
                        <h3 class="text-2xl font-bold text-slate-800 mb-2">Sortir 8 Asnaf Penerima Zakat</h3>
                        <p class="text-slate-600 text-sm leading-relaxed">
                            Beras zakat sudah terkumpul di masjid! Sekarang bantu Amil Zakat menyalurkan kantong zakat hanya kepada **8 Golongan Asnaf** yang berhak menerima.
                        </p>
                    </div>

                    <div class="bg-teal-50 border border-teal-200 p-3.5 rounded-2xl text-xs text-teal-900 max-w-md text-left">
                        <p class="font-bold mb-1">🎮 Cara Bermain:</p>
                        <p>Klik atau Seret (Drag) kartu golongan ke dalam **Lumbung Zakat Fitrah**. Hati-hati, jangan memilih golongan yang tidak berhak!</p>
                    </div>

                    <button onclick="startBabak3Sorting()" class="px-8 py-3.5 bg-teal-600 hover:bg-teal-700 text-white font-bold rounded-xl shadow-md transition transform active:scale-95 flex items-center gap-2">
                        <span>Mulai Menyortir</span>
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            `;
        }

        function startBabak3Sorting() {
            sfx.playClick();
            gameState.sortedAsnafCount = 0;
            // Shuffle items
            const shuffledItems = [...asnafItemsData].sort(() => Math.random() - 0.5);
            renderBabak3Board(shuffledItems);
        }

        function renderBabak3Board(items) {
            const card = document.getElementById('gameCard');

            card.innerHTML = `
                <div class="flex flex-col justify-between h-full space-y-4">
                    <!-- Header level 3 -->
                    <div class="flex justify-between items-center border-b border-slate-100 pb-2">
                        <div>
                            <span class="text-xs font-bold text-teal-600 uppercase tracking-wider">Babak 3: Penyaluran Asnaf</span>
                            <h3 class="text-base sm:text-lg font-bold text-slate-800">Pilih / Seret Golongan Berhak Ke Lumbung</h3>
                        </div>
                        <div class="bg-teal-100 text-teal-800 text-xs font-bold px-3 py-1 rounded-lg">
                            Terkumpul: <span id="asnafCountText">0</span>/8 Asnaf
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-start my-auto">
                        <!-- Source Pool Items -->
                        <div class="bg-slate-50 border border-slate-200 p-3 rounded-2xl max-h-[260px] overflow-y-auto space-y-2">
                            <p class="text-xs font-bold text-slate-500 mb-2">Daftar Golongan (Klik/Seret ke Lumbung):</p>
                            <div id="asnafPool" class="grid grid-cols-1 gap-2">
                                ${items.map(item => `
                                    <div id="${item.id}" draggable="true" ondragstart="handleDragStart(event, '${item.id}')" onclick="handleAsnafClick('${item.id}')"
                                        class="draggable-item bg-white border border-slate-200 p-2.5 rounded-xl shadow-sm hover:border-teal-400 flex items-center justify-between">
                                        <div>
                                            <p class="text-xs sm:text-sm font-bold text-slate-800">${item.name}</p>
                                            <p class="text-[11px] text-slate-500">${item.desc}</p>
                                        </div>
                                        <i class="fas fa-hand-holding-hand text-slate-300"></i>
                                    </div>
                                `).join('')}
                            </div>
                        </div>

                        <!-- Target Drop Zone (Lumbung Zakat) -->
                        <div id="dropZone" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event)"
                            class="drop-zone border-2 border-dashed border-teal-400 bg-teal-50/50 p-4 rounded-2xl min-h-[240px] flex flex-col items-center justify-center text-center space-y-3 transition">
                            
                            <div class="w-16 h-16 rounded-2xl bg-teal-500 text-white flex items-center justify-center text-3xl shadow-md">
                                <i class="fas fa-wheat-awn"></i>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-teal-900">Lumbung Penerima Zakat Fitrah</h4>
                                <p class="text-xs text-teal-700 mt-1">Letakkan 8 Golongan Asnaf di sini</p>
                            </div>
                            
                            <!-- Collected Asnaf Tags Inside Zone -->
                            <div id="collectedTags" class="flex flex-wrap gap-1.5 justify-center w-full pt-2">
                                <!-- Tags dynamically inserted here -->
                            </div>
                        </div>
                    </div>

                    <!-- Feedback msg -->
                    <div id="asnafFeedback" class="hidden p-3 rounded-xl text-xs font-medium"></div>

                    <div class="flex justify-end">
                        <button id="finishGameBtn" onclick="finishGame()" class="hidden px-6 py-3 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold rounded-xl shadow-lg transition flex items-center gap-2">
                            <span>Selesaikan Misi & Lihat Hasil</span>
                            <i class="fas fa-trophy"></i>
                        </button>
                    </div>
                </div>
            `;
        }

        // --- Drag & Drop / Click Logic ---
        function handleDragStart(ev, id) {
            ev.dataTransfer.setData("text/plain", id);
        }

        function handleDragOver(ev) {
            ev.preventDefault();
            document.getElementById('dropZone').classList.add('drag-over');
        }

        function handleDragLeave(ev) {
            document.getElementById('dropZone').classList.remove('drag-over');
        }

        function handleDrop(ev) {
            ev.preventDefault();
            document.getElementById('dropZone').classList.remove('drag-over');
            const id = ev.dataTransfer.getData("text/plain");
            processAsnafSelection(id);
        }

        function handleAsnafClick(id) {
            processAsnafSelection(id);
        }

        function processAsnafSelection(id) {
            const item = asnafItemsData.find(i => i.id === id);
            const itemEl = document.getElementById(id);
            const feedbackEl = document.getElementById('asnafFeedback');

            if (!item || !itemEl) return;

            if (item.isAsnaf) {
                sfx.playCorrect();
                gameState.score += 20;
                gameState.sortedAsnafCount++;
                updateHeader();

                // Remove item from pool
                itemEl.remove();

                // Add tag inside drop zone
                const collectedArea = document.getElementById('collectedTags');
                const tag = document.createElement('span');
                tag.className = "bg-teal-600 text-white text-xs font-bold px-2.5 py-1 rounded-lg flex items-center gap-1 shadow-sm animate-bounce";
                tag.innerHTML = `<i class="fas fa-check text-[10px]"></i> ${item.name}`;
                collectedArea.appendChild(tag);

                document.getElementById('asnafCountText').innerText = gameState.sortedAsnafCount;

                feedbackEl.className = "p-3 rounded-xl text-xs font-bold bg-emerald-100 border border-emerald-300 text-emerald-900";
                feedbackEl.innerHTML = `✨ Benar! <b>${item.name}</b> adalah termasuk 8 Asnaf yang berhak menerima zakat. (+20 Skor)`;
                feedbackEl.classList.remove('hidden');

                if (gameState.sortedAsnafCount >= gameState.targetAsnafCount) {
                    document.getElementById('finishGameBtn').classList.remove('hidden');
                }
            } else {
                sfx.playWrong();
                feedbackEl.className = "p-3 rounded-xl text-xs font-bold bg-rose-100 border border-rose-300 text-rose-900";
                feedbackEl.innerHTML = `❌ Kurang Tepat! <b>${item.name}</b> bukan termasuk golongan Asnaf penerima zakat fitrah.`;
                feedbackEl.classList.remove('hidden');
            }
        }

        /* ===================================================
           7. FINISH & SUMMARY SCREEN
           =================================================== */
        function finishGame() {
            sfx.playWin();
            gameState.currentRound = 4;
            updateHeader();

            // Trigger Confetti Celebration
            confetti({
                particleCount: 120,
                spread: 70,
                origin: { y: 0.6 }
            });

            const card = document.getElementById('gameCard');
            card.innerHTML = `
                <div class="flex flex-col items-center text-center space-y-6 my-auto py-4">
                    <!-- Medal / Trophy Graphic -->
                    <div class="relative">
                        <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-3xl bg-gradient-to-tr from-amber-400 to-amber-600 text-white flex items-center justify-center text-5xl shadow-xl shadow-amber-500/30 animate-bounce">
                            <i class="fas fa-award"></i>
                        </div>
                    </div>

                    <div>
                        <span class="inline-block px-3 py-1 rounded-full text-xs font-extrabold bg-emerald-100 text-emerald-800 mb-2">
                            🎉 Misi Selesai Dengan Sempurna!
                        </span>
                        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-800">
                            Terima Kasih, Amil Zakat Hebat!
                        </h2>
                        <p class="text-slate-600 text-sm mt-1">Kamu telah berhasil menuntaskan seluruh tantangan materi PAI Kelas 5 Bab 4.</p>
                    </div>

                    <!-- Final Score Card -->
                    <div class="bg-gradient-to-r from-emerald-50 to-teal-50 border border-emerald-200 p-4 sm:p-6 rounded-2xl w-full max-w-md text-center">
                        <p class="text-xs uppercase font-bold text-slate-500 tracking-wider">Total Skor Akhir Kamu</p>
                        <p class="text-4xl sm:text-5xl font-extrabold text-emerald-600 my-1">${gameState.score}</p>
                        <p class="text-xs text-emerald-800 font-semibold">Predikat: Amil Zakat Teladan 🌟</p>
                    </div>

                    <!-- Educational Summary Box (Kurikulum Merdeka PAI Grade 5) -->
                    <div class="bg-amber-50/90 border border-amber-200 p-4 sm:p-5 rounded-2xl text-left max-w-xl text-xs sm:text-sm text-amber-950 space-y-2">
                        <h4 class="font-extrabold text-amber-900 flex items-center gap-2 text-sm sm:text-base border-b border-amber-200/80 pb-2">
                            <i class="fas fa-book-quran text-amber-600"></i> Rangkuman Materi Zakat Fitrah
                        </h4>
                        <p>1. <b>Pengertian:</b> Zakat fitrah dikeluarkan untuk membersihkan diri dari dosa serta menyucikan jiwa dan harta.</p>
                        <p>2. <b>Hukum:</b> Wajib bagi setiap muslim (laki-laki, perempuan, tua, muda) yang mampu dan menjumpai bulan Ramadan.</p>
                        <p>3. <b>Takaran:</b> 2,5 kg atau 3,5 liter bahan makanan pokok (beras) per jiwa.</p>
                        <p>4. <b>Waktu Utama:</b> Terbenam matahari akhir Ramadan hingga sebelum Sholat Idul Fitri.</p>
                        <p>5. <b>8 Asnaf Berhak:</b> Fakir, Miskin, Amil, Muallaf, Riqab, Gharimin, Fisabilillah, dan Ibnu Sabil.</p>
                        <div class="mt-3 pt-2 border-t border-amber-200/80 text-emerald-900 font-bold italic text-center">
                            "Dengan membayar zakat fitrah, kita belajar berbagi dan hidup lapang hati. Membantu sesama membuat kehidupan lebih berkah dan penuh kepedulian."
                        </div>
                    </div>

                    <!-- Play Again Button -->
                    <button onclick="startGame()" class="px-8 py-4 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white text-base font-bold rounded-2xl shadow-lg transition transform active:scale-95 flex items-center gap-3">
                        <i class="fas fa-rotate-right"></i>
                        <span>Mainkan Lagi</span>
                    </button>
                </div>
            `;
        }

        // Initialize Game on Load
        window.onload = function() {
            renderIntroScreen();
        };
    </script>
</body>
</html>
